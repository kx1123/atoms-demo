# Runtime only. Store the real file at /opt/atoms-demo/shared/runtime.env, mode 600.
ATOMS_PUBLIC_ORIGIN=http://YOUR_SERVER_IP:3100
MODEL_BASE_URL=https://YOUR_PROVIDER/v1
MODEL_API_KEY=REPLACE_WITH_YOUR_KEY
MODEL_NAME=REPLACE_WITH_YOUR_MODEL
MODEL_TIMEOUT_MS=300000
MODEL_IDLE_TIMEOUT_MS=90000
# Optional, only when your provider supports this request field.
# MODEL_THINKING=disabled
MODEL_DAILY_LIMIT=12
MODEL_IP_DAILY_LIMIT=20
MODEL_GLOBAL_DAILY_LIMIT=50
MODEL_MAX_CONCURRENT=2
