# Copy to .env.local and fill in your provider's Chat Completions settings.
# This endpoint should accept POST {model,messages,stream:true} (JSON fallback supported).
MODEL_BASE_URL=https://your-provider.example/v1
MODEL_API_KEY=
MODEL_NAME=
# Per-model-call deadline, including a separate full deadline for the repair call.
MODEL_TIMEOUT_MS=300000
# Stop a stalled stream even if the provider keeps sending empty heartbeats.
MODEL_IDLE_TIMEOUT_MS=90000
# Optional provider-specific thinking mode. Set disabled when supported for lower latency.
# MODEL_THINKING=disabled
# Optional. Defaults to ./data/atoms.sqlite
# ATOMS_DB_PATH=./data/atoms.sqlite
# Maximum real model runs per anonymous session per day.
MODEL_DAILY_LIMIT=30
# Only needed for a future public deployment behind a configured reverse proxy.
# ATOMS_PUBLIC_ORIGIN=https://your-app.example
